    <h1>𓆙 BAN SITE</h1>
    <div class="subtitle">Centre de signalement</div>
</header>


<div class="account-selector">

    <button
        id="messengerBtn"
        class="account-btn active"
        type="button"
        onclick="selectAccountType('messenger')">
        Messenger
    </button>

    <button
        id="businessBtn"
        class="account-btn"
        type="button"
        onclick="selectAccountType('business')">
        Business
    </button>

</div>

<div class="card">

    <label for="target">Numéro / cible</label>
    <input
        id="target"
        type="text"
        placeholder="+224XXXXXXXXX"
        autocomplete="off"
    >

    <label for="type">Motif</label>
    <select id="type">
        <option value="spam">Spam / messages indésirables</option>
        <option value="abus">Harcèlement / abus</option>
        <option value="fraude">Fraude / arnaque</option>
        <option value="usurpation">Usurpation d'identité</option>
        <option value="autre">Autre</option>
    </select>

    <label for="description">Rapport</label>
    <textarea
        id="description"
        placeholder="Explique clairement les faits et indique pourquoi tu signales cette cible..."
    ></textarea>

    <button onclick="prepareReport()">
        PRÉPARER LE SIGNALEMENT
    </button>

    <div id="status" class="status"></div>

</div>


<div id="reportBox" class="card report-box">

    <h2>📄 Rapport préparé</h2>

    <pre id="generatedReport"></pre>

    <button class="whatsapp" onclick="openWhatsAppContact()">
        🌐 OUVRIR LE CONTACT OFFICIEL WHATSAPP
    </button>

    <button class="mail" onclick="openMail()">
        📧 PRÉPARER L'ENVOI PAR E-MAIL
    </button>

    <button class="secondary" onclick="openWhatsAppApp()">
        OUVRIR WHATSAPP — APPLICATION
    </button>

    <div class="small" style="margin-top:15px">
        Le canal officiel peut demander des informations ou des preuves
        supplémentaires. BAN SITE ne prétend pas envoyer directement le
        signalement à WhatsApp.
    </div>

</div>




</div>


<script>

const API = "http://127.0.0.1:8081";

const OFFICIAL_CONTACT =
    "https://www." + "whatsapp.com/contact/";

let currentReport = "";

let accountType = "messenger";

const MESSENGER_EMAILS = [
    "support@support.whatsapp.com",
    "support@whatsapp.com",
    "abuse@support.whatsapp.com",
    "privacy@support.whatsapp.com"
];

const BUSINESS_EMAILS = [
    "android_web@support.whatsapp.com",
    "Smb@support.whatsapp.com",
    "Accessibility@support.whatsapp.com",
    "Support@support.whatsapp.com",
    "Support@whatsapp.com"
];


function selectAccountType(type){

    accountType = type;

    const messengerBtn =
        document.getElementById("messengerBtn");

    const businessBtn =
        document.getElementById("businessBtn");

    if(type === "messenger"){

        messengerBtn.classList.add("active");
        businessBtn.classList.remove("active");
    }else{

        businessBtn.classList.add("active");
        messengerBtn.classList.remove("active");
    }
}



function showStatus(message){

    const box = document.getElementById("status");

    box.style.display = "block";
    box.innerHTML = message;
}


function normalizeTarget(value){

    return value
        .trim()
        .replace(/[^\d+]/g,"");
}


function prepareReport(){

    const targetInput =
        document.getElementById("target");

    const typeInput =
        document.getElementById("type");

    const descriptionInput =
        document.getElementById("description");

    const evidenceInput =
        document.getElementById("evidence");

    const reportBox =
        document.getElementById("reportBox");

    const target =
        normalizeTarget(targetInput.value);

    const type =
        typeInput.value;

    const description =
        descriptionInput.value.trim();

    const evidence =
        evidenceInput.files[0];


    // Nettoyage des erreurs précédentes
    targetInput.classList.remove("field-error");
    descriptionInput.classList.remove("field-error");


    if(!target){

        targetInput.classList.add("field-error");

        showStatus(
            "❌ Veuillez entrer le numéro ou la cible."
        );

        targetInput.focus();

        return;
    }


    if(target.length < 7){

        targetInput.classList.add("field-error");

        showStatus(
            "❌ La cible semble trop courte."
        );

        targetInput.focus();

        return;
    }


    if(!description){

        descriptionInput.classList.add("field-error");

        showStatus(
            "❌ Veuillez décrire le motif du signalement."
        );

        descriptionInput.focus();

        return;
    }


    const labels = {

        spam:"Spam / messages indésirables",

        abus:"Harcèlement / abus",

        fraude:"Fraude / arnaque",

        usurpation:"Usurpation d'identité",

        autre:"Autre"

    };


    const date =
        new Date().toLocaleString("fr-FR");


    const accountLabel =
        accountType === "business"
            ? "WhatsApp Business"
            : "WhatsApp Messenger";


    currentReport =
`OBJET : Signalement

Type de compte :
${accountLabel}

Numéro / cible :
${target}

Motif :
${labels[type] || "Autre"}

Description :
${description}

Date de préparation :
${date}`;


    document.getElementById(
        "generatedReport"
    ).textContent = currentReport;


    if(reportBox){

        reportBox.style.display = "block";

        reportBox.classList.remove(
            "report-box"
        );

        void reportBox.offsetWidth;

        reportBox.classList.add(
            "report-box"
        );
    }


    showStatus(
        "✅ Rapport préparé. Vérifie les informations avant de poursuivre."
    );


    saveLocalReport(
        target,
        type,
        description
    );
}


function openWhatsAppContact(){

    if(!currentReport){

        showStatus(
            "❌ Prépare d'abord le rapport."
        );

        return;
    }


    navigator.clipboard.writeText(
        currentReport
    ).catch(()=>{});


    window.open(
        OFFICIAL_CONTACT,
        "_blank"
    );
}


function openWhatsAppApp(){

    if(!currentReport){

        showStatus(
            "❌ Prépare d'abord le rapport."
        );

        return;
    }

    // Le rapport reste dans le presse-papiers
    // afin de pouvoir être collé manuellement dans WhatsApp.
    navigator.clipboard.writeText(
        currentReport
    ).catch(()=>{});

    // Tentative d'ouverture de l'application WhatsApp.
    window.location.href = "whatsapp://";

    setTimeout(() => {

        showStatus(
            "📋 Rapport copié. " +
            "WhatsApp a été ouvert si l'application accepte le lien. " +
            "Tu peux ensuite coller le rapport."
        );

    }, 700);
}


function openMail(){

    if(!currentReport){

        showStatus(
            "❌ Prépare d'abord le rapport."
        );

        return;
    }

    const recipients =
        accountType === "business"
            ? BUSINESS_EMAILS
            : MESSENGER_EMAILS;

    const subject =
        accountType === "business"
            ? "Signalement WhatsApp Business"
            : "Signalement WhatsApp";

    const body =
        currentReport;

    const mailto =
        "mailto:" +
        recipients.join(",") +
        "?subject=" +
        encodeURIComponent(subject) +
        "&body=" +
        encodeURIComponent(body);

    showStatus(
        accountType === "business"
            ? "📧 Rapport Business préparé pour les 5 destinataires."
            : "📧 Rapport Messenger préparé pour les 4 destinataires."
    );

    window.location.href = mailto;
}

async function saveLocalReport(
    target,
    type,
    description
){

    try{

        const body =
            new URLSearchParams();

        body.append(
            "target",
            target
        );

        body.append(
            "type",
            type
        );

        body.append(
            "description",
            description
        );


        await fetch(
            API + "/api/report",
            {
                method:"POST",

                headers:{
                    "Content-Type":
                        "application/x-www-form-urlencoded"
                },

                body:body.toString()
            }
        );


        loadHistory();

    }catch(error){

        console.log(
            "Historique local indisponible",
            error
        );
    }
}


async function loadHistory(){

    const history =
        document.getElementById("history");


    try{

        const response =
            await fetch(
                API + "/api/history"
            );


        const data =
            await response.json();


        if(
            !data.success ||
            !Array.isArray(data.items)
        ){

            history.innerHTML =
                "<p class='small'>Aucun historique.</p>";

            return;
        }


        if(data.items.length === 0){

            history.innerHTML =
                "<p class='small'>Aucun signalement enregistré.</p>";

            return;
        }


        history.innerHTML =
            data.items
                .slice()
                .reverse()
                .map(item => {

                    return `
                    <div class="history-item">

                        <strong>
                            ${escapeHTML(item.target)}
                        </strong>

                        <br>

                        <span class="badge">
                            ${escapeHTML(item.type)}
                        </span>

                        <div class="small">
                            ${escapeHTML(item.date || "")}
                        </div>

                        <div class="small">
                            Statut :
                            ${escapeHTML(item.status || "reçu")}
                        </div>

                    </div>
                    `;

                })
                .join("");


    }catch(error){

        history.innerHTML =
            "<p class='small'>API indisponible.</p>";
    }
}


function escapeHTML(value){

    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");
}


loadHistory();

</script>

</body>
</html>