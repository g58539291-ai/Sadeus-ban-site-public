<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    background:
        radial-gradient(circle at 15% 35%, rgba(255,20,55,.42), transparent 38%),
        radial-gradient(circle at 85% 35%, rgba(30,70,255,.42), transparent 38%),
        radial-gradient(circle at 50% 70%, rgba(150,25,255,.24), transparent 42%),
        linear-gradient(135deg,#050207,#070912,#03040a);
    background-size:160% 160%;
    background-position:0% 50%;
    color:#fff;
    font-family:Arial,sans-serif;
    animation:sadeusBackground 14s ease-in-out infinite alternate;
}

@keyframes sadeusBackground{
    0%{
        background-position:0% 50%;
    }
    50%{
        background-position:100% 45%;
    }
    100%{
        background-position:20% 60%;
    }
}

.container{
    width:min(700px,92%);
    margin:35px auto;
}

header{
    text-align:center;
    margin-bottom:25px;
}

h1{
    margin:0;
    font-size:32px;
}

.subtitle{
    color:#aaa;
    margin-top:8px;
}

.card{
    background:#121212;
    border:1px solid #292929;
    border-radius:18px;
    padding:22px;
    margin-bottom:18px;
}

label{
    display:block;
    margin:15px 0 7px;
    font-weight:bold;
}

input,select,textarea{
    width:100%;
    padding:13px;
    border-radius:10px;
    border:1px solid #333;
    background:#0b0b0b;
    color:#fff;
    outline:none;
    font-size:15px;
}

textarea{
    min-height:150px;
    resize:vertical;
}

button{
    width:100%;
    padding:14px;
    margin-top:16px;
    border:0;
    border-radius:11px;
    background:#fff;
    color:#000;
    font-weight:bold;
    font-size:15px;
    cursor:pointer;
}

button.secondary{
    background:#242424;
    color:#fff;
}

button.whatsapp{
    background:#25D366;
    color:#000;
}

button.mail{
    background:#ddd;
    color:#000;
}

.status{
    display:none;
    padding:15px;
    margin-top:15px;
    border-radius:10px;
    background:#1d1d1d;
    line-height:1.5;
}

.report-box{
    display:none;
}

pre{
    white-space:pre-wrap;
    word-break:break-word;
    background:#080808;
    padding:15px;
    border-radius:10px;
    border:1px solid #292929;
    color:#ddd;
    line-height:1.5;
}

.small{
    color:#888;
    font-size:13px;
    line-height:1.5;
}

.history-item{
    padding:14px 0;
    border-bottom:1px solid #292929;
}

.history-item:last-child{
    border-bottom:0;
}

.badge{
    display:inline-block;
    padding:4px 8px;
    border-radius:7px;
    background:#242424;
    font-size:12px;
    margin-top:5px;
}


/* ===== BAN SITE — INTERFACE COMPACTE ===== */

.container{
    width:min(680px,94%);
    margin:18px auto;
}

header{
    margin-bottom:14px;
}

h1{
    font-size:27px;
}

.subtitle{
    margin-top:4px;
    font-size:13px;
}

.card{
    border-radius:14px;
    padding:15px;
    margin-bottom:12px;
}

label{
    margin:9px 0 5px;
    font-size:14px;
}

input,select,textarea{
    padding:10px;
    font-size:14px;
}

textarea{
    min-height:105px;
}

button{
    padding:11px;
    margin-top:10px;
    font-size:13px;
}

#generatedReport{
    max-height:180px;
    overflow-y:auto;
    margin:8px 0;
    padding:11px;
    font-size:12px;
}

.report-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
}

.report-actions button{
    margin-top:0;
}

.report-actions .full{
    grid-column:1 / -1;
}

.small{
    font-size:11px;
}



/* ===== MESSENGER / BUSINESS ===== */

.account-selector{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-bottom:12px;
}

.account-btn{
    margin-top:0;
    padding:12px 8px;
    border-radius:12px;
    font-size:13px;
    font-weight:bold;
    cursor:pointer;
}

.account-btn.active{
    outline:2px solid currentColor;
}


/* ===== BAN SITE — FINITION INTERFACE ===== */

.account-selector{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-bottom:14px;
}

.account-btn{
    margin:0;
    padding:12px 8px;
    border:1px solid rgba(255,255,255,.12);
    border-radius:12px;
    font-size:13px;
    font-weight:700;
    cursor:pointer;
    transition:
        transform .15s ease,
        opacity .15s ease,
        box-shadow .15s ease;
}

.account-btn:active{
    transform:scale(.98);
}

.account-btn.active{
    box-shadow:0 0 0 2px currentColor;
}

.card{
    transition:
        transform .15s ease,
        box-shadow .15s ease;
}

input:focus,
select:focus,
textarea:focus{
    outline:none;
    box-shadow:0 0 0 2px rgba(255,255,255,.18);
}

.field-error{
    box-shadow:0 0 0 2px rgba(255,70,70,.65) !important;
}

.preparing{
    opacity:.7;
    pointer-events:none;
}

.report-box{
    animation:reportAppear .25s ease;
}

@keyframes reportAppear{
    from{
        opacity:0;
        transform:translateY(8px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}



/* ===== GOJO SADEUS — IDENTITÉ VISUELLE ===== */

body{
    background:
        radial-gradient(circle at 8% 35%, rgba(255,20,55,.65), transparent 38%),
        radial-gradient(circle at 92% 35%, rgba(25,70,255,.65), transparent 38%),
        radial-gradient(circle at 50% 52%, rgba(150,20,255,.34), transparent 36%),
        linear-gradient(135deg,#050107 0%,#080612 50%,#02040b 100%);
    background-size:160% 160%;
    color:#f4f6ff;
    position:relative;
    overflow-x:hidden;
    animation:sadeusBackground 12s ease-in-out infinite alternate;
}

/* Aura rouge + bleue */
body::before{
    content:"";
    position:fixed;
    inset:-25%;
    pointer-events:none;
    z-index:-1;
    background:
        radial-gradient(circle at 18% 50%, rgba(255,0,55,.38), transparent 32%),
        radial-gradient(circle at 82% 50%, rgba(0,65,255,.38), transparent 32%),
        radial-gradient(circle at 50% 50%, rgba(170,20,255,.20), transparent 30%);
    filter:blur(28px);
    animation:sadeusAura 9s ease-in-out infinite alternate;
}

@keyframes sadeusBackground{
    0%{
        background-position:0% 50%;
    }
    50%{
        background-position:100% 45%;
    }
    100%{
        background-position:20% 60%;
    }
}

@keyframes sadeusAura{
    0%{
        transform:translateX(-4%) scale(1);
    }
    50%{
        transform:translateX(4%) translateY(-2%) scale(1.08);
    }
    100%{
        transform:translateX(-2%) translateY(3%) scale(1.04);
    }
}

/* Identité Sadeus discrète */
body::after{
    content:"𓆙  SADEUS 𓆙";
    position:fixed;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%) rotate(-18deg);
    font-size:clamp(55px,16vw,150px);
    font-weight:900;
    letter-spacing:12px;
    color:rgba(255,255,255,.018);
    white-space:nowrap;
    pointer-events:none;
    z-index:-1;
}

/* Titre */
header h1{
    text-shadow:
        0 0 8px rgba(80,100,255,.65),
        0 0 25px rgba(90,70,255,.35);
}

.subtitle{
    color:#9ca8ff;
    letter-spacing:2px;
}

/* Cartes */
.card{
    background:rgba(10,12,22,.78);
    border:1px solid rgba(120,135,255,.20);
    box-shadow:
        0 10px 40px rgba(0,0,0,.45),
        0 0 25px rgba(60,75,255,.08);
    backdrop-filter:blur(12px);
}

/* Sélecteur Messenger / Business */
.account-selector{
    background:rgba(8,10,18,.72);
    border:1px solid rgba(120,135,255,.18);
    box-shadow:0 0 25px rgba(60,75,255,.08);
    backdrop-filter:blur(10px);
}

.account-btn{
    font-family:Arial,sans-serif;
    font-weight:700;
    letter-spacing:1.2px;
    text-transform:uppercase;
    transition:.25s ease;
    border:1px solid rgba(255,255,255,.12);
    color:#fff;
}

.account-btn:hover{
    transform:translateY(-1px);
    box-shadow:0 0 18px rgba(80,100,255,.25);
}

.account-btn.active{
    box-shadow:
        0 0 15px rgba(80,100,255,.35),
        inset 0 0 15px rgba(80,100,255,.08);
}

/* Champs */
input,
select,
textarea{
    background:rgba(3,5,12,.72);
    border-color:rgba(120,135,255,.20);
    color:#f4f6ff;
}

input:focus,
select:focus,
textarea:focus{
    border-color:rgba(105,125,255,.75);
    box-shadow:0 0 14px rgba(75,95,255,.18);
}

/* Bouton principal */
button{
    transition:.25s ease;
}

button:hover{
    transform:translateY(-1px);
}

/* Petite signature */


